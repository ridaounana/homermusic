# ---- Discord -----------------------------------------------------------
DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
# Servers to register commands in, comma-separated = instant.
# Blank, or `npm run deploy -- --global`, registers everywhere (up to 1h).
GUILD_ID=your-server-id,another-server-id

# ---- Branding ----------------------------------------------------------
BOT_NAME=Music
# Every command is registered under this one name, so a server full of music
# bots doesn't give you six identical /play entries. Blank = flat /play, /skip.
COMMAND_NAMESPACE=homer
EMBED_COLOR=9B59B6
# Footer on the now-playing and queue embeds. Leave blank to remove it.
BRAND_FOOTER=built for chaos333 community

# The line under the bot's name. A bot cannot show the green Spotify card
# (album art, progress bar, clickable link) - that is user-accounts only.
# listening | playing | watching | competing | custom. Blank leaves it unset.
PRESENCE_TEXT=CHAOS - JEAN
PRESENCE_TYPE=listening
# online | idle | dnd | invisible
PRESENCE_STATUS=online
# Discord clears presence on reconnect, so it is re-applied on this interval.
PRESENCE_REFRESH_MS=600000

# ---- Lavalink node -----------------------------------------------------
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=CHANGE_THIS_PASSWORD
LAVALINK_SECURE=false

# ---- Playback ----------------------------------------------------------
# ytmsearch | ytsearch | scsearch | spsearch | dzsearch | amsearch
DEFAULT_SEARCH=ytmsearch
DEFAULT_VOLUME=80
MAX_VOLUME=200
EMPTY_CHANNEL_TIMEOUT_MS=120000
IDLE_TIMEOUT_MS=300000
MAX_QUEUE_SIZE=1000
MAX_PREVIOUS_TRACKS=25

DATA_FILE=./data/guilds.json

# ---- YouTube via yt-dlp -------------------------------------------------
# Lavalink's YouTube source resolves tracks it then cannot stream. When that
# happens the bot re-fetches the same video with yt-dlp and plays the file
# locally. Leave YTDLP_PATH blank to turn the whole thing off.
YTDLP_ENABLED=true
YTDLP_PATH=
# yt-dlp ignores PATH for its JS runtime. Without an explicit, current Node
# here it reports "node (unavailable)" and every download fails with 403.
YTDLP_NODE=
YT_CACHE_DIR=./data/ytcache
YT_CACHE_MAX_MB=2048
YT_CACHE_PORT=2444
YTDLP_TIMEOUT_MS=90000
