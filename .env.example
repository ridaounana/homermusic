# ---- Discord -----------------------------------------------------------
DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
# Register commands to one server = instant. Blank = global (up to 1h).
GUILD_ID=your-test-server-id

# ---- Branding ----------------------------------------------------------
BOT_NAME=Music
EMBED_COLOR=9B59B6
# Footer on the now-playing and queue embeds. Leave blank to remove it.
BRAND_FOOTER=built for chaos333 community

# ---- Lavalink node -----------------------------------------------------
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=CHANGE_THIS_PASSWORD
LAVALINK_SECURE=false

# ---- Playback ----------------------------------------------------------
# ytmsearch | ytsearch | scsearch | spsearch | dzsearch | amsearch
DEFAULT_SEARCH=ytmsearch
DEFAULT_VOLUME=80
MAX_VOLUME=200
EMPTY_CHANNEL_TIMEOUT_MS=120000
IDLE_TIMEOUT_MS=300000
MAX_QUEUE_SIZE=1000
MAX_PREVIOUS_TRACKS=25

DATA_FILE=./data/guilds.json
